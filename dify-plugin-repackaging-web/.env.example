# Port configuration
PORT=80

# Backend CORS origins (comma-separated list or JSON array)
# Examples:
# BACKEND_CORS_ORIGINS=https://your-domain.com,https://another-domain.com
# BACKEND_CORS_ORIGINS=["https://your-domain.com","https://another-domain.com"]
BACKEND_CORS_ORIGINS=https://your-domain.com

# Rate limiting
RATE_LIMIT_PER_MINUTE=10

# File retention in hours
FILE_RETENTION_HOURS=24

# Maximum file size in bytes (500MB)
MAX_FILE_SIZE=524288000

# Redis configuration (if using external Redis)
# REDIS_URL=redis://localhost:6379/0

# Allowed download domains (comma-separated)
# ALLOWED_DOWNLOAD_DOMAINS=github.com,githubusercontent.com,marketplace.dify.ai,dify.ai

# ============================================
# Authentication
# ============================================
# Password for API authentication via HTTP Basic Auth or X-Auth-Token header
# Leave empty or comment out to disable authentication (development mode)
# Use a strong password in production (generate with: openssl rand -base64 32)
# Example: AUTH_PASSWORD=dGhpc2lzYXZlcnlsb25nc2VjdXJlcGFzc3dvcmQ=
# AUTH_PASSWORD=

# Rate limiting for failed authentication attempts (per minute per IP)
# AUTH_RATE_LIMIT_PER_MINUTE=5