# =============================================================================
# Dify Plugin Repackaging - Environment Configuration
# =============================================================================
# Copy this file to .env and update the values according to your environment
# NEVER commit the actual .env file to version control!

# =============================================================================
# BACKEND CONFIGURATION
# =============================================================================

# CORS Origins - Allowed domains for cross-origin requests
# Format: Comma-separated list OR JSON array
# Examples:
#   BACKEND_CORS_ORIGINS=https://your-domain.com,https://another-domain.com
#   BACKEND_CORS_ORIGINS=["https://your-domain.com","https://another-domain.com"]
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost

# API Configuration
API_V1_STR=/api/v1
DEBUG=false

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================

# Redis connection URL
# Format: redis://[username][:password]@host:port/database
# Examples:
#   Without password: redis://localhost:6379/0
#   With password: redis://:your-password@localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# Redis Password (recommended for production)
# Leave empty for development without password
# Generate strong password: openssl rand -base64 32
REDIS_PASSWORD=

# =============================================================================
# CELERY CONFIGURATION
# =============================================================================

# Celery Broker URL (uses Redis)
# If REDIS_PASSWORD is set, use: redis://:${REDIS_PASSWORD}@redis:6379/0
# Otherwise use: redis://redis:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# Celery Result Backend (uses Redis)
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# =============================================================================
# FILE MANAGEMENT
# =============================================================================

# Temporary directory for file processing
TEMP_DIR=/tmp/dify-plugin-repackaging

# Upload directory for received files
UPLOAD_DIR=/tmp/dify-plugin-uploads

# File retention period in hours (default: 24 hours)
FILE_RETENTION_HOURS=24

# File retention period in days (for completed files, default: 7 days)
FILE_RETENTION_DAYS=7

# Maximum file size in bytes (default: 500MB = 524288000 bytes)
MAX_FILE_SIZE=524288000

# =============================================================================
# SECURITY
# =============================================================================

# Secret key for session management and cryptographic operations
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Or: openssl rand -base64 32
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Rate limiting (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=30

# Allowed domains for downloading plugins
# Comma-separated list (default includes GitHub and Dify Marketplace)
ALLOWED_DOWNLOAD_DOMAINS=github.com,githubusercontent.com,marketplace.dify.ai,dify.ai

# =============================================================================
# EXTERNAL API CONFIGURATION
# =============================================================================

# GitHub API URL (change for GitHub Enterprise)
GITHUB_API_URL=https://github.com

# Dify Marketplace API URL
MARKETPLACE_API_URL=https://marketplace.dify.ai

# Marketplace cache TTL in seconds (default: 1 hour = 3600)
MARKETPLACE_CACHE_TTL=3600

# =============================================================================
# PYTHON/PIP CONFIGURATION
# =============================================================================

# PyPI mirror URL for faster downloads in China
# Default (China): https://mirrors.aliyun.com/pypi/simple
# Official PyPI: https://pypi.org/simple
PIP_MIRROR_URL=https://pypi.org/simple

# =============================================================================
# HTTP CLIENT CONFIGURATION
# =============================================================================

# HTTP timeout settings (in seconds)
HTTP_TIMEOUT=30.0
HTTP_CONNECT_TIMEOUT=10.0
HTTP_READ_TIMEOUT=60.0
HTTP_WRITE_TIMEOUT=30.0
HTTP_POOL_TIMEOUT=10.0

# =============================================================================
# WEBSOCKET CONFIGURATION
# =============================================================================

# WebSocket heartbeat interval in seconds
WS_HEARTBEAT_INTERVAL=30

# =============================================================================
# DOCKER DEPLOYMENT CONFIGURATION
# =============================================================================

# Port for nginx/frontend (docker-compose only)
PORT=80

# Scripts directory (container path)
SCRIPTS_DIR=/app/scripts

# =============================================================================
# PRODUCTION DEPLOYMENT NOTES
# =============================================================================
#
# For production deployment:
# 1. Generate strong SECRET_KEY and REDIS_PASSWORD
# 2. Set DEBUG=false
# 3. Configure proper BACKEND_CORS_ORIGINS with your domain
# 4. Use strong REDIS_PASSWORD and update CELERY URLs accordingly
# 5. Adjust rate limiting and file retention based on your needs
# 6. Consider using environment-specific .env files (.env.production, etc.)
# 7. NEVER commit .env files to version control
#
# For Coolify deployment, configure these variables in Coolify's environment
# variable management interface.
# =============================================================================
